# ==============================================================================
# EngageMind AI — Environment Configuration
# ==============================================================================

# 1. Operating Mode: 'copilot' (Recommended & 100% Safe) or 'stealth' (Playwright auto-posting)
ENGAGEMIND_MODE=copilot

# 2. AI Model Provider (Choose Anthropic or OpenRouter)
ENGAGEMIND_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=sk-ant-api03-xxxx
ENGAGEMIND_ANTHROPIC_MODEL=claude-3-7-sonnet-20250219

OPENROUTER_API_KEY=sk-or-v1-xxxx
ENGAGEMIND_OPENROUTER_MODEL=anthropic/claude-3.7-sonnet

# 3. Telegram HITL Notification Studio
TELEGRAM_BOT_TOKEN=123456789:ABCDEF...
TELEGRAM_CHAT_ID=987654321

# 4. LinkedIn Personal Session Cookie (Required only for live Playwright scanning or stealth posting)
# Get from Chrome DevTools -> Application -> Cookies -> www.linkedin.com -> 'li_at'
LINKEDIN_LI_AT=AQED...

# 5. Anti-Ban Safety Limits
ENGAGEMIND_MAX_COMMENTS_PER_DAY=4
ENGAGEMIND_MIN_COOLDOWN_MINUTES=60
ENGAGEMIND_ACTIVE_HOURS_START=9
ENGAGEMIND_ACTIVE_HOURS_END=19
TIMEZONE=Africa/Cairo

# 6. Human Keystroke Jitter (in milliseconds)
ENGAGEMIND_TYPING_DELAY_MIN_MS=45
ENGAGEMIND_TYPING_DELAY_MAX_MS=140
ENGAGEMIND_SCAN_INTERVAL_SECONDS=3600
